# Definir a página padrão como index.php
DirectoryIndex index.php

<FilesMatch "\.json$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Exceção: libera version.json para checagem de atualização 
<Files "version.json">
    Order Allow,Deny
    Allow from all
</Files>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
